{
  "name": "my_football_legend",
  "version": "0.1.0",
  "private": true,
  "description": "Narracyjny symulator kariery piłkarza działający w przeglądarce.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "audit:archetypes": "vitest run scripts/archetypeAudit.test.ts --reporter=verbose",
    "audit:world": "vitest run scripts/worldAudit.test.ts --reporter=verbose",
    "generate:world-db": "vitest run scripts/generateWorldDatabase.test.ts --reporter=verbose",
    "audit:startup": "vitest run scripts/startupAudit.test.ts --reporter=verbose",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
