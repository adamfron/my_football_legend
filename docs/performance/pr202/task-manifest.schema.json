{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "pr202-ci-manifest-v1"
    },
    "base": {
      "type": "string"
    },
    "originalWorkflowSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageScriptsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "quality"
        },
        "timeoutMinutes": {
          "type": "number",
          "const": 30
        },
        "os": {
          "type": "string",
          "const": "ubuntu-latest"
        },
        "originalNeeds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposedNeeds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requireEveryResult": {
          "type": "string",
          "const": "success"
        },
        "originalCommand": {
          "type": "string"
        },
        "proposedProgram": {
          "type": "string"
        },
        "rejectedResults": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "timeoutMinutes",
        "os",
        "originalNeeds",
        "proposedNeeds",
        "requireEveryResult",
        "originalCommand",
        "proposedProgram",
        "rejectedResults"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "command": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "originalJob": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "timeoutMinutes": {
            "anyOf": [
              {
                "type": "number",
                "const": 30
              },
              {
                "type": "number",
                "const": 45
              }
            ]
          },
          "requiredResult": {
            "type": "string",
            "const": "success"
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "receipt": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "resultSha256": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "finalHash": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "source": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "path": {
                              "type": "string"
                            },
                            "archiveSha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            },
                            "fingerprint": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            },
                            "base": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "path",
                            "archiveSha256",
                            "fingerprint",
                            "base"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "sha256",
                    "resultSha256",
                    "finalHash",
                    "source"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "receipt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "command",
          "originalJob",
          "os",
          "node",
          "timeoutMinutes",
          "requiredResult",
          "cases"
        ],
        "additionalProperties": false
      }
    },
    "original": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "tasks"
        ],
        "additionalProperties": false
      }
    },
    "proposed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "measuredPayloadSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "tasks",
          "measuredPayloadSeconds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "base",
    "originalWorkflowSha256",
    "packageScriptsSha256",
    "gate",
    "tasks",
    "original",
    "proposed"
  ],
  "additionalProperties": false
}
